# ==================================================
# ОБЩИЕ НАСТРОЙКИ
# ==================================================

# Окружение: development, staging, production
ENVIRONMENT=development

# Django Secret Key (сгенерируйте новый для production!)
SECRET_KEY=django-insecure-change-this-in-production-to-random-50-characters-key

# Debug режим (НИКОГДА не включайте в production!)
DEBUG=True

# Разрешённые хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS разрешённые источники (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================================================
# БАЗА ДАННЫХ
# ==================================================

DB_ENGINE=django.db.backends.postgresql
DB_NAME=garantkg
DB_USER=garantkg_user
DB_PASSWORD=garantkg_password_change_in_production
DB_HOST=db
DB_PORT=5432

# ==================================================
# REDIS
# ==================================================

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==================================================
# EMAIL (для уведомлений)
# ==================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@garant.kg

# Для разработки можно использовать console backend:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ==================================================
# ПЛАТЁЖНАЯ СИСТЕМА (заглушка)
# ==================================================

# Провайдер: fake (для разработки), реальный провайдер будет позже
PAYMENT_PROVIDER=fake

# Комиссия платформы (в процентах)
PLATFORM_FEE_PERCENT=5.0

# ==================================================
# БЕЗОПАСНОСТЬ
# ==================================================

# Защита от брутфорса (django-axes)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# Rate limiting (запросов в минуту)
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour

# JWT настройки (время жизни в минутах)
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=10080

# ==================================================
# ФАЙЛЫ И МЕДИА
# ==================================================

# Максимальный размер загружаемого файла (в МБ)
MAX_UPLOAD_SIZE=10

# Разрешённые типы файлов (через запятую)
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx,zip

# ==================================================
# ОПЦИОНАЛЬНЫЕ СЕРВИСЫ
# ==================================================

# Sentry для мониторинга ошибок (опционально)
SENTRY_DSN=

# ClamAV антивирус (опционально)
CLAMAV_ENABLED=False
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ==================================================
# PRODUCTION СПЕЦИФИЧНЫЕ
# ==================================================

# Домен сайта
SITE_DOMAIN=garant.kg

# HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ==================================================
# ЛОГИРОВАНИЕ
# ==================================================

LOG_LEVEL=INFO
